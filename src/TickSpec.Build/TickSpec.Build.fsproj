<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>exe</OutputType>
    <RollForward>LatestMajor</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>1591;NU5100</NoWarn>
    <WarningsNotAsErrors>618,672</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Entities.fs" />
    <Compile Include="GherkinParser.fs" />
    <Compile Include="TestFixtureGenerator.fs" />
    <Compile Include="HtmlGenerator.fs" />
    <Compile Include="TestApi.fs" />
    <Compile Include="BindingVerifier.fs" />
    <Compile Include="Targets.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TickSpec.CodeGen\TickSpec.CodeGen.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser.FSharp" Version="2.9.1" />
    <PackageReference Include="TickSpec" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
  </ItemGroup>

</Project>