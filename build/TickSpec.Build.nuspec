<?xml version="1.0"?>
<package >
  <metadata>
    <id>TickSpec.Build</id>
    <title>TickSpec.Build</title>
    <version>5.0.0</version>
    <authors>Plainionist</authors>
    <owners>Plainionist</owners>
    <license type="expression">BSD-3-Clause</license>
    <projectUrl>https://github.com/plainionist/TickSpec.Build</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Generates test classes to execute TickSpec (Gherkin/BDD) based specifications</description>
    <readme>docs\README.md</readme>
    <copyright>Copyright 2025</copyright>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="FSharp.Core" version="10.1.402" />
        <dependency id="NUnit" version="5.0.0" />
        <dependency id="TickSpec" version="2.0.5" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\README.md" target="docs\" />
    <file src="TickSpec.Build.targets" target="build" />
    <file src="..\src\TickSpec.Build\bin\Release\net10.0\*" target="tasks\net10.0" />
    <file src="..\src\TickSpec.CodeGen\bin\Release\net10.0\*" target="lib\net10.0" />
  </files>
</package>